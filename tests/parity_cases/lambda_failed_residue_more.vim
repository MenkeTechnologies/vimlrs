" A failing lambda returns what eval1() left in rettv: for a call that failed
" after its arguments Number 0, for && || ?: ?? the operand eval1() cleared,
" for a slice the cleared base.
echo string({-> Nosuch()}())
echo string({-> Nosuch(1, 2)}())
echo string({-> Nosuch(nosuch)}())
echo string({-> len([], 2)}())
echo string({-> function('len')()}())
echo string({-> len(nosuch)}())
echo string({-> 1 && nosuch}())
echo string({-> 0 || nosuch}())
echo string({-> 0 || 0 || nosuch}())
echo string({-> 1 && 1 && nosuch}())
echo string({-> 1.5 && nosuch}())
echo string({-> nosuch && 1}())
echo string({-> 0 && nosuch}())
echo string({-> 1 || nosuch}())
echo string({-> [] && 1}())
echo string({-> 1 && []}())
echo string({-> 1 ? nosuch : 2}())
echo string({-> 0 ? 2 : nosuch}())
echo string({-> 'a' ? 2 : nosuch}())
echo string({-> [] ? 2 : 3}())
echo string({-> nosuch ? 1 : 2}())
echo string({-> 1 ? 5 : nosuch}())
echo string({-> 0 ?? nosuch}())
echo string({-> 1 ?? nosuch}())
echo string({-> '' ?? nosuch}())
echo string({-> [] ?? nosuch}())
echo string({-> 'abc'[1:nosuch]}())
echo string({-> [1,2][1:nosuch]}())
echo string({-> [1,2,3][1:]}())
echo string({-> 'abc'[nosuch:]}())
echo string({x -> x ? x * 2 : nosuch}(3))
echo string(map([1, 2], {_, v -> v > 1 && v < 5}))
let F = function('len')
echo string({-> F(nosuch)}())
echo string({-> F()}())
echo string({x -> x ? 1 : nosuch}(0))
